{
  "name": "phantom-vpn",
  "version": "3.0.2",
  "description": "Phantom VPN — Free WARP + Pro VLESS channel via Telegram",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "electron:dev": "concurrently \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "electron:build": "vite build && electron-builder",
    "download-singbox": "powershell -ExecutionPolicy Bypass -File electron/scripts/download-singbox.ps1",
    "start": "vite --open"
  },
  "dependencies": {
    "framer-motion": "^11.0.0",
    "lucide-react": "^0.344.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.56",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.17",
    "concurrently": "^8.2.2",
    "electron": "^28.2.0",
    "electron-builder": "^24.9.1",
    "postcss": "^8.4.35",
    "puppeteer-core": "^24.43.0",
    "tailwindcss": "^3.4.1",
    "vite": "^5.1.4",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.phantom.vpn",
    "productName": "Phantom VPN",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "public/icon.ico"
    ],
    "win": {
      "target": "portable",
      "icon": "public/icon.ico",
      "signAndEditExecutable": false,
      "artifactName": "Phantom-VPN-${version}.exe"
    },
    "extraResources": [
      {
        "from": "public/bg.jpg",
        "to": "."
      },
      {
        "from": "electron/bin",
        "to": "bin",
        "filter": ["**/*", "!.gitkeep"]
      }
    ]
  }
}
